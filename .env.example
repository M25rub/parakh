# Copy to .env (never commit .env!)
GOOGLE_API_KEY=your-gemini-api-key          # from aistudio.google.com
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-flash-latest
SAFE_BROWSING_API_KEY=your-safe-browsing-key
PARAKH_MOCK=1                               # 1 = fake demo data, 0 = real agent
USE_GMAIL_MCP=1
MEMORY_BACKEND=local                        # local | firestore
GOOGLE_APPLICATION_CREDENTIALS=credentials/firestore-key.json   # only for firestore
SCAN_ENABLED=1                              # 0 on the public site (Gmail is test-users only)
# workspace-mcp (Gmail + Calendar) - see its README for exact names
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=parakh.demo@gmail.com
